.md-inline-form(layout="column" ng-cloak)
  %form.gd-form(name="ctrl.insForm")
    %md-content(layout-padding layout-gt-xs="row")
      %div(flex)
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %gd-input(label="Name" is-edit="isEditing" ng-model="insurance.name" field-name="name" ng-required="true" form="ctrl.insForm" flex)
          %gd-input(label="HP ID" is-edit="isEditing" ng-model="insurance.hp_id_code" field-name="hp_id_code" form="ctrl.insForm" ng-blur="setIncomingHpCode" flex)
          %gd-input(label="Payer ID" is-edit="isEditing" ng-model="insurance.payerid" field-name="payerid" form="ctrl.insForm" flex)
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %gd-input(label="Medicare HMO Provider?" is-edit="isEditing" ng-if="!isEditing" ng-model="insurance.medicare_hmo" flex)
          %md-switch(ng-model="insurance.medicare_hmo" ng-if="isEditing" aria-label="Medicare HMO" flex)
            Medicare HMO Provider?

        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %gd-input(label="Address 1" is-edit="isEditing" ng-model="insurance.address1" field-name="address1" form="ctrl.insForm" flex)
          %gd-input(label="Address 2" is-edit="isEditing" ng-model="insurance.address2" field-name="address2" form="ctrl.insForm" flex)
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %gd-input(label="City" is-edit="isEditing" ng-model="insurance.city" field-name="city" form="ctrl.insForm" flex)
          %gd-drop-down(label="State" is-edit="isEditing" ng-model="insurance.state" field-name="state" dd-type="main" keyprefix="STATES" form="ctrl.insForm" flex)
          %gd-input(label="Zip" is-edit="isEditing" ng-model="insurance.zip" field-name="zip" form="ctrl.insForm" flex)
