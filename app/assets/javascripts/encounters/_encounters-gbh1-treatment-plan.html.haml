.odd(layout-gt-xs="row" layout-padding)
  %gd-drop-down(form="formsec.sections.treatment.form" ng-blur="formsec.sections.treatment.revalidate" ng-required="true" is-edit="isEditing" dd-type="encounter" keyprefix="PLANRECOMMENDED" label="Type/amount of psychotherapy service recommended" ng-model="myEncounter.plan.amount_of_service" flex)
  %gd-dd-multiselect(form="formsec.sections.treatment.form" ng-blur="formsec.sections.treatment.revalidate" ng-required="myEncounter.plan.amount_of_service.name == '4'" freetext="true" is-edit="isEditing" dd-type="encounter" keyprefix="PLANNOTRECOMMENDED" label="Reason psychotherapy not recommended" ng-model="myEncounter.plan.not_recommended_reason" flex ng-show="myEncounter.plan.amount_of_service.name == '4'")
  %gd-drop-down(form="formsec.sections.treatment.form" ng-blur="formsec.sections.treatment.revalidate" ng-required="myEncounter.plan.amount_of_service.name != '4'" freetext="true" is-edit="isEditing" dd-type="encounter" keyprefix="PLANFREQUENCY" label="Frequency" ng-model="myEncounter.plan.frequency" flex ng-show="myEncounter.plan.amount_of_service.name != '4'")
.even(layout-gt-xs="row" layout-padding ng-show="myEncounter.plan.amount_of_service.name != '4'")
  %gd-drop-down(form="formsec.sections.treatment.form" ng-blur="formsec.sections.treatment.revalidate" ng-required="myEncounter.plan.amount_of_service.name != '4'" freetext="true" is-edit="isEditing" dd-type="encounter" keyprefix="PLANDURATION" label="Duration" ng-model="myEncounter.plan.duration" flex)
  %gd-dd-multiselect(form="formsec.sections.treatment.form" is-edit="isEditing" dd-type="encounter" keyprefix="PLANOTHERSERVICES" label="Other Services" ng-model="myEncounter.plan.other_services" freetext="true" flex)
.odd(layout-gt-xs="row" layout-padding)
  %span Staff apprised of goals and provided oral guidelines and summary of treatment
