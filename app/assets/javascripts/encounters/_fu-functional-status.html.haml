.odd(layout-gt-xs="row" layout-padding)
  %gd-drop-down(form="formsec.sections.mental.form" ng-blur="formsec.sections.mental.revalidate" ng-required="true" is-edit="isEditing" dd-type="encounter" keyprefix="CGIS" label="Clinical Global Impression-Severity" ng-model="myEncounter.functional_status.severity" flex)
.even(layout-gt-xs="row" layout-padding)
  %div(flex)
    %gd-radio(form="formsec.sections.mental.form" ng-blur="formsec.sections.mental.revalidate" ng-required="true" is-edit="isEditing" dd-type="encounter" keyprefix="ATTITUDE" label="Behavioral Style/Attitude" ng-model="myEncounter.functional_status.attitude" flex)
    %gd-dd-multiselect(form="formsec.sections.mental.form" ng-blur="formsec.sections.mental.revalidate" ng-required="myEncounter.functional_status.attitude.name == 'B'" freetext="true" ng-show="myEncounter.functional_status.attitude.name == 'B'" is-edit="isEditing" dd-type="encounter" keyprefix="ATTITUDEPROB" label="Attitude issues" ng-model="myEncounter.functional_status.attitude.problems" flex)
.odd(layout-gt-xs="row" layout-padding)
  %gd-bool(form="formsec.sections.mental.form" ng-blur="formsec.sections.mental.revalidate" ng-required="true" is-edit="isEditing" label="Expressed threat of harm to self or others" ng-model="myEncounter.functional_status.harm" flex)
  %gd-dd-multiselect(form="formsec.sections.mental.form" ng-blur="formsec.sections.mental.revalidate" ng-required="myEncounter.functional_status.harm.name == 'Y'" is-edit="isEditing" dd-type="encounter" keyprefix="EXPRHARM" label="Expressed threat of harm to self or others" ng-model="myEncounter.functional_status.harm.problems" flex ng-show="myEncounter.functional_status.harm.name == 'Y'")
.even(layout-gt-xs="row" layout-padding)
  %gd-bool(form="formsec.sections.mental.form" ng-blur="formsec.sections.mental.revalidate" ng-required="true" freetext="true" is-edit="isEditing" label="Observed or suspected change in mental status since initial assessment" ng-model="myEncounter.functional_status.status_changed" flex)
.odd(layout-gt-xs="row" layout-padding)
  %div(flex)
    %fieldset(name="assessment-ability-respond")
      %legend
        Assement of patient's ability to respond to treatment
      %div(layout-gt-xs="row" layout-xs="column" layout-padding)
        %div(flex="50")
          %gd-drop-down(form="formsec.sections.mental.form" ng-blur="formsec.sections.mental.revalidate" ng-required="true" freetext="true" is-edit="isEditing" dd-type="encounter" keyprefix="RESPONDTREATMNT" label="Dementia Screening" ng-model="myEncounter.functional_status.respondtreatment" flex)
          %div(layout-gt-xs="row" layout-xs="column" layout-padding ng-if="respondtreatmentLinks.display && isEditing")
            %span(flex ng-if="respondtreatmentLinks.url[0] != '#'")
              %a(href="{{respondtreatmentLinks.url}}" target="_TREATTAB")
                {{respondtreatmentLinks.title}}
            %span(flex ng-if="respondtreatmentLinks.url[0] == '#'")
              %a(href="{{respondtreatmentLinks.url}}" ng-click="doScreening($event)")
                {{respondtreatmentLinks.title}}

        %div(flex="50")
          %gd-input(form="formsec.sections.mental.form" ng-blur="formsec.sections.mental.revalidate" ng-required="true" is-edit="isEditing" label="Cognitive Screen Score" ng-model="myEncounter.functional_status.cognitive_screen" flex)
      %div(layout-gt-xs="row" layout-xs="column" layout-padding)
        %gd-drop-down(form="formsec.sections.mental.form" ng-blur="formsec.sections.mental.revalidate" ng-required="true" freetext="true" ft-model="myEncounter.functional_status.respondtreatment_desc_text" is-edit="isEditing" dd-type="encounter" keyprefix="RESPNDTREATMNTDESC" label="Description" ng-model="myEncounter.functional_status.respondtreatment_desc" flex)
      %div(layout-gt-xs="row" layout-xs="column" layout-padding)
        %gd-input(form="formsec.sections.mental.form" is-edit="isEditing" label="Comments" ng-model="myEncounter.functional_status.respondtreatment_comments" flex)
.even(layout-gt-xs="row" layout-padding)
  %gd-bool(form="formsec.sections.mental.form" ng-blur="formsec.sections.mental.revalidate" ng-required="true" is-edit="isEditing" label="Interactive Complexity" ng-model="myEncounter.functional_status.interactive_complexity" flex)
  %div(flex ng-if="myEncounter.functional_status.interactive_complexity.name=='Y'")
    %gd-dd-multiselect(form="formsec.sections.mental.form" ng-blur="formsec.sections.mental.revalidate" ng-required="true" freetext="true" is-edit="isEditing" dd-type="encounter" keyprefix="REASONINTEACTVCOMPLXTY" label="Reason for Interactive Complexity" ng-model="myEncounter.functional_status.interactive_complexity.problems" flex)
