%md-dialog(aria-label="Encounter export dialog" ng-cloak)
  %form(name="ctrl.encExportForm")
    %md-toolbar
      .md-toolbar-tools
        %h2 Export Options
        %span(flex)
        %md-button.md-icon-button(ng-click="cancel()")
          %md-icon(md-svg-icon="navigation:ic_close_24px" aria-label="close dialog")

    %md-dialog-content
      .md-dialog-content
        %md-radio-group(ng-model="encExport.opt" ng-required="true")
          %md-radio-button.md-primary(value="full") Full Note
          %md-radio-button.md-primary(value="no addendum") Omit Addendum
          %md-radio-button.md-primary(value="no note") Omit Confidential
          %md-radio-button.md-primary(value="partial") Omit Addendum and Confidential

        %md-divider

      %md-dialog-actions(layout="row")
        %span(flex)
        %md-button(ng-click="cancel()") Cancel
        %md-button(ng-click="submit()" ng-disabled="ctrl.encExportForm.$invalid") Submit

