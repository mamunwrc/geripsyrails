%md-divider
.container(layout="column" layout-fill)
  %div(flex)
    %md-toolbar.md-primary(layout="row")
      .md-toolbar-tools
        %span Encounters: Filter
        %span(flex)
    %md-content(flex layout-padding)
      %div(layout-gt-xs="row" layout-xs="column" layout-padding)
        %md-input-container.md-block(flex-gt-sm)
          %label Patient
          %md-select(ng-model="searchObj.patient" multiple ng-model-options="{trackBy: '$value.name'}")
            %md-select-header.dd-search-header
              %input.md-text.dd-search-filter(ng-model="patientFilter" type="search" placeholder="Filter list...")
            %md-optgroup
              %md-option(ng-repeat="patient in patients | filter:patientFilter" ng-value="{val:patient.keyvalue, name:patient.keyname}")
                {{ ::patient.keyvalue }}

        %gd-dd-multiselect(ng-if="providers.length > 0" ng-model="searchObj.provider" is-edit="true" label="Provider" collection="providers" field-name="providerID" flex)
        %gd-dd-multiselect(ng-if="facilities.length > 0" ng-model="searchObj.facility" is-edit="true" label="Facility" collection="facilities" field-name="facilityID" flex)
      %div(ng-if="!isTreatmentPlan" layout-gt-xs="row" layout-xs="column" layout-padding)
        %gd-dd-multiselect(ng-model="searchObj.cpt_code" is-edit="true" label="CPT Code" collection="cpt_codes" field-name="cptCode" flex)
        %gd-dd-multiselect(ng-if="user.user_type != 'Usr::Reviewer' || user.reviewer_type == 'practice'" ng-model="searchObj.signed" is-edit="true" label="Status" field-name="signedStatus" collection="statuses" flex)

      %div(ng-if="!isTreatmentPlan" layout-gt-xs="row" layout-xs="column" layout-padding)
        %gd-dd-multiselect(ng-model="searchObj.primary_insurances" is-edit="true" label="Primary Insurance" collection="insurances" field-name="primary_insurances" flex)
        %gd-dd-multiselect(ng-model="searchObj.secondary_insurances" is-edit="true" label="Secondary Insurance" collection="insurances" field-name="secondary_insurances" flex)

      %div(layout-gt-xs="row" layout-xs="column" layout-padding)
        %gd-dd-multiselect(ng-model="searchObj.category" ng-if="categories.length > 0" is-edit="true" label="Form category" collection="categories" field-name="category" flex)
        %div(flex)
      %div(ng-if="!isTreatmentPlan" layout-gt-xs="row" layout-xs="column" layout-padding)
        %gd-date(ng-model="searchObj.from" is-edit="true" label="Date of Service From" field-name="date of service from" flex)
        %gd-date(ng-model="searchObj.to" is-edit="true" label="Date of Service To" field-name="date of service to" flex)
        %span(flex)

      %div(layout-gt-xs="row" layout-xs="column" layout-padding)
        %gd-date(ng-model="searchObj.signedFrom" is-edit="true" label="Date Signed From" field-name="date signed from" flex)
        %gd-date(ng-model="searchObj.signedTo" is-edit="true" label="Date Signed To" field-name="date signed to" flex)
        %span(flex)

      %md-divider

      %div(ng-if="isCategorySelected(9)")
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %span(flex)
          %h2 Patient Information
          %span(flex)
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %gd-dd-multiselect(ng-model="searchObj.referral_initiators" is-edit="true" label="Referral Initiated By" collection="referral_initiators" field-name="referral_initiator" flex)
          %md-input-container.md-block(flex)
            %label Referring MD Name
            %md-select(ng-model="searchObj.referral_md_name" ng-model-options="{trackBy: '$value.name'}")
              %md-select-header.dd-search-header
                %input.md-text.dd-search-filter(ng-model="mdNameFilter" type="search" placeholder="Filter list...")
              %md-optgroup
                %md-option(ng-value="{}")
                  Select MD Name
                %md-option(ng-repeat="record in referral_md_names | filter:mdNameFilter" ng-value="{val:record.keyvalue, name:record.keyname}")
                  {{ ::record.keyvalue }}
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %gd-date(ng-model="searchObj.service_date_from" is-edit="true" label="Service Date From" field-name="service_date_from" flex)
          %gd-date(ng-model="searchObj.service_date_to" is-edit="true" label="Service Date To" field-name="service_date_to" flex)
          %span(flex)
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %gd-date(ng-model="searchObj.md_order_date_from" is-edit="true" label="MD Order Date From" field-name="md_order_date_from" flex)
          %gd-date(ng-model="searchObj.md_order_date_to" is-edit="true" label="MD Order Date To" field-name="md_order_date_to" flex)
          %span(flex)
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %md-input-container.md-block(flex)
            %label Reason for treatment hiatus
            %md-select(ng-model="searchObj.referral_hiatus_reason" ng-model-options="{trackBy: '$value.name'}")
              %md-optgroup
                %md-option(ng-value="{}")
                  Select
                %md-option(ng-repeat="record in referral_hiatus_reasons" ng-value="{val:record.keyvalue, name:record.keyname}")
                  {{ ::record.keyvalue }}
          %div(flex)
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %gd-dd-multiselect(ng-model="searchObj.referral_reasons" is-edit="true" label="Reason for referral" collection="referral_reasons" field-name="referral_reason" flex)
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %gd-dd-multiselect(ng-model="searchObj.referral_medical_necessities" is-edit="true" label="Medical Necessity" collection="referral_medical_necessities" field-name="referral_medical_necessity" flex)
          %div(flex)

