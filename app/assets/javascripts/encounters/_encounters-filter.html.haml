                  {{ ::record.keyvalue }}

      %div(ng-if="isCategorySelected(12)")
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %span(flex)
          %h2 Target Symptoms and Treatment Plan Interventions
          %span(flex)
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %gd-dd-multiselect(ng-model="searchObj.problem_major_target_symptoms" is-edit="true" label="Major target symptom" collection="problem_major_target_symptoms" field-name="problem_major_target_symptoms" flex)
          %div(flex)
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %md-input-container.md-block(flex)
            %label Primary Onset
            %md-select(ng-model="searchObj.problem_onset" ng-model-options="{trackBy: '$value.name'}")
              %md-optgroup
                %md-option(ng-value="{}")
                  Select
                %md-option(ng-repeat="record in problem_onsets" ng-value="{val:record.keyvalue, name:record.keyname}")
                  {{ ::record.keyvalue }}
          %md-input-container.md-block(flex)
            %label Frequency
            %md-select(ng-model="searchObj.problem_frequency" ng-model-options="{trackBy: '$value.name'}")
              %md-optgroup
                %md-option(ng-value="{}")
                  Select
                %md-option(ng-repeat="record in problem_frequencies" ng-value="{val:record.keyvalue, name:record.keyname}")
                  {{ ::record.keyvalue }}
          %md-input-container.md-block(flex)
            %label Intensity
            %md-select(ng-model="searchObj.problem_intensity" ng-model-options="{trackBy: '$value.name'}")
              %md-optgroup
                %md-option(ng-value="{}")
                  Select
                %md-option(ng-repeat="record in problem_intensities" ng-value="{val:record.keyvalue, name:record.keyname}")
                  {{ ::record.keyvalue }}
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %gd-dd-multiselect(ng-model="searchObj.problem_others" is-edit="true" label="Other Reported Problems" collection="problem_others" field-name="problem_others" flex)
          %gd-dd-multiselect(ng-model="searchObj.problem_tp_interventions" is-edit="true" label="Treatment Plan Interventions" collection="problem_tp_interventions" field-name="problem_tp_interventions" flex)

      %div(ng-if="isCategorySelected(13)")
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %span(flex)
          %h2 Initial Recommendations and Plan
          %span(flex)
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %md-input-container.md-block(flex)
            %label Type/Amount of psychotherapy service recommended
            %md-select(ng-model="searchObj.plan_amount_of_service" ng-model-options="{trackBy: '$value.name'}")
              %md-optgroup
                %md-option(ng-value="{}")
                  Select
                %md-option(ng-repeat="record in plan_amount_of_services" ng-value="{val:record.keyvalue, name:record.keyname}")
                  {{ ::record.keyvalue }}
          %md-input-container.md-block(flex)
            %label Frequency
            %md-select(ng-model="searchObj.plan_frequency" ng-model-options="{trackBy: '$value.name'}")
              %md-optgroup
                %md-option(ng-value="{}")
                  Select
                %md-option(ng-repeat="record in plan_frequencies" ng-value="{val:record.keyvalue, name:record.keyname}")
                  {{ ::record.keyvalue }}
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %md-input-container.md-block(flex)
            %label Duration
            %md-select(ng-model="searchObj.plan_duration" ng-model-options="{trackBy: '$value.name'}")
              %md-optgroup
                %md-option(ng-value="{}")
                  Select
                %md-option(ng-repeat="record in plan_durations" ng-value="{val:record.keyvalue, name:record.keyname}")
                  {{ ::record.keyvalue }}
          %gd-dd-multiselect(ng-model="searchObj.plan_other_services" is-edit="true" label="Other Services" collection="plan_other_services" field-name="plan_other_services" flex)

      %div(ng-if="isCategorySelected(14)")
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %span(flex)
          %h2 Methods of Monitoring Outcomes
          %span(flex)
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %md-input-container.md-block(flex)
            %label Clinical Global Impression - Severity
            %md-select(ng-model="searchObj.functional_status_severity" ng-model-options="{trackBy: '$value.name'}")
              %md-optgroup
                %md-option(ng-value="{}")
                  Select
                %md-option(ng-repeat="record in functional_status_severities" ng-value="{val:record.keyvalue, name:record.keyname}")
                  {{ ::record.keyvalue }}
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %gd-dd-multiselect(ng-model="searchObj.tp_methods_methods" is-edit="true" label="Monitoring Methods" collection="tp_methods_methods" field-name="tp_methods_methods" flex)
          %div(flex)

      %div(ng-if="isCategorySelected(15)")
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %span(flex)
          %h2 Certification
          %span(flex)
        %div(layout-gt-xs="row" layout-xs="column" layout-padding)
          %gd-date(ng-model="searchObj.certification_from" is-edit="true" label="Date of Treatment Plan From" field-name="from" flex)
          %gd-date(ng-model="searchObj.certification_to" is-edit="true" label="Date of Treatment Plan To" field-name="to" flex)
          %span(flex)

      %div(flex layout="row")
        %md-button.md-raised.md-primary(ng-click="filter()") Submit
        %span(flex)
        %md-button.md-raised(ng-click="export()")
          %md-icon(md-svg-icon="image:ic_picture_as_pdf_24px" aria-label="print")
          Export PDF

    %md-divider

    %md-content.md-padding
      %bgf-pagination( |
        collection="encounters" |
        url="searchURL" |
        url-params="global.search" |
        page="global.pagination.page" |
        per-page="global.pagination.perPage" |
        client-limit="global.pagination.clientLimit" |
        transform-response="searchTransform" |
        link-group-size="2" )

      %md-list
        %md-list-item.md-3-line.md-accent(ng-repeat="encounter in encounters" ng-click="globalPatients.setPatient(encounter.patient.id)" ui-sref="{{routeFor(encounter)}}")
          .md-list-item-text(layout-padding)
            %h3 {{ [encounter.patient.last_name, encounter.patient.first_name].join(", ") }}
            %p {{ encounter.service_date | dateonly }}
            %span CPT Code: {{ encounter.encounter_type }}
          %md-divider(md-inset hide-sm ng-if="!$last")
          %md-divider(hide-gt-sm ng-if="!$last")
        %md-list-item.md-2-line(ng-if="encounters.length == 0")
          .md-list-item-text
            %h3 Nothing to display
        %md-divider

