%h2(flex="100" layout-align="center")
  {{ initialHeader }}
%h3(flex="100" layout-align="center")

%h4(flex="100") I. Patient Information

%div(flex="33")
  %strong.md-caption Last Name:
  %span.md-caption {{format(patient.last_name)}}
%div(flex="33")
  %strong.md-caption First Name:
  %span.md-caption {{format(patient.first_name)}}
%div(flex="33")
  %strong.md-caption DOB:
  %span.md-caption {{patient.dob | dateonly}}

%div(flex="33")
  %strong.md-caption Facility:
  %span.md-caption(ng-if="!patient.room_num") {{format(patient.facility.name)}}
  %span.md-caption(ng-if="patient.room_num") {{format(patient.facility.name)}}/{{patient.room_num}}
%div(flex="33")
  %strong.md-caption Gender:
  %span.md-caption {{format(patient.gender)}}
%div(flex="33")
  %strong.md-caption Referral initiated by:
  %span.md-caption {{format(encounter.referral.initiator)}}

%div(flex="33")
  %strong.md-caption Referring MD name:
  %span.md-caption {{format(encounter.referral.md_name)}}
%div(flex="33")
  %strong.md-caption Date of MD order:
  %span.md-caption {{format(encounter.referral.order_date) | dateonly}}
%div(flex="33")

%div(ng-if="is90791")
  %div(flex="100" ng-if="encounter.referral.hiatus.name == 'Y'")
    %strong.md-caption Patient was seen in the last year for a 90791. A hiatus in treatment has taken place due to:
    %span.md-caption
      {{ hiatusFormat(encounter.referral.hiatus_reason) }}
  %div(flex="100" ng-if="encounter.referral.hiatus.name == 'Y' && encounter.referral.hiatus_comment")
    %strong.md-caption Comment:
    %span.md-caption {{ encounter.referral.hiatus_comment }}
  %div(flex="100")
    %strong.md-caption Reason for referral:
    %span.md-caption(ng-repeat="reason in encounter.referral.reasons")
      {{format(reason)}} - {{format(encounter.referral.reasons_freetext[reason.name])}}
      %span(ng-if="!$last"); 

  %div(flex="100")
    %strong.md-caption Medical necessity:
    %span.md-caption {{format(encounter.referral.medical_necessity)}}

%div(flex="100" ng-if="encounter.referral.note")
  %strong.md-caption Note:
  %span.md-caption {{format(encounter.referral.note)}}

%h4(flex="100") II. Mental Status Examination

%div(flex="100")
  %strong.md-caption Clinical Global Impression-Severity:
  %span.md-caption {{format(encounter.functional_status.severity)}}

%div(flex="50")
  %strong.md-caption Orientation Problems:
  %span.md-caption {{formatProb(encounter.functional_status.orientation, 'problems', 'P')}}
%div(flex="50")
  %strong.md-caption Appearance and Dress:
  %span.md-caption {{formatProb(encounter.functional_status.appearance, 'problems', 'I')}}

%div(flex="50")
  %strong.md-caption Motor Activity:
  %span.md-caption {{formatProb(encounter.functional_status.motor, 'problems', 'R')}}
%div(flex="50")
  %strong.md-caption Alertness/Concentration:
  %span.md-caption {{format(encounter.functional_status.alertness, 'problems')}}

%div(flex="50")
  %strong.md-caption Mood:
  %span.md-caption {{formatProb(encounter.functional_status.mood, 'problems', 'A')}}
%div(flex="50")
  %strong.md-caption Affect:
  %span.md-caption {{formatProb(encounter.functional_status.affect, 'problems', 'B')}}

%div(flex="50")
  %strong.md-caption Communication/Expression:
  %span.md-caption {{formatProb(encounter.functional_status.expression, 'problems', 'B')}}
%div(flex="50")
  %strong.md-caption Behavioral Style/Attitude:
  %span.md-caption {{formatProb(encounter.functional_status.attitude, 'problems', 'B')}}

%div(flex="50")
  %strong.md-caption Judgment/Reasoning:
  %span.md-caption {{format(encounter.functional_status.reasoning, 'problems')}}
%div(flex="50")
  %strong.md-caption Motivation:
  %span.md-caption {{format(encounter.functional_status.motivation, 'problems')}}

%div(flex="50")
  %strong.md-caption Thought Process:
  %span.md-caption {{formatProb(encounter.functional_status.thought_process, 'hallucinations', '3', true)}}
%div(flex="50")
  %strong.md-caption Thought content/preoccupations:
  %span.md-caption {{format(encounter.functional_status.thought_content)}}

%div(flex="100")
  %strong.md-caption Memory/Recall:
  %span.md-caption {{format(encounter.functional_status.recall)}}

%div(flex="50")
  %strong.md-caption Intellectual ability:
  %span.md-caption {{format(encounter.functional_status.intellectual_ability)}}
%div(flex="50")
  %strong.md-caption Insight/Awareness of problem:
  %span.md-caption {{format(encounter.functional_status.insight)}}

%div(flex="100")
  %strong.md-caption Expressed threat of harm to self or others:
  %span.md-caption {{formatProb(encounter.functional_status.harm, 'problems', 'Y')}}

%div(flex="100")
  %strong.md-caption Cognitive screen:
  %span.md-caption {{ format(encounter.functional_status.respondtreatment)}}; {{ format(encounter.functional_status.cognitive_screen)}}; {{format(encounter.functional_status.respondtreatment_desc)}}

%div(flex="100" ng-if="encounter.functional_status.respondtreatment_comments")
  %strong.md-caption Comments:
  %span.md-caption {{ encounter.functional_status.respondtreatment_comments }}

%div(flex="100" ng-if="encounter.functional_status.note")
  %strong.md-caption Note:
  %span.md-caption {{format(encounter.functional_status.note)}}

%div(flex="100" ng-if="is90791 && encounter.functional_status.interactive_complexity.name == 'Y'")
  %strong.md-caption Interactive complexity:
  %span.md-caption {{formatIntComp(encounter.functional_status.interactive_complexity, 'problems')}}

%h4(flex="100") III. Background and History

%div(flex="50")
  %strong.md-caption Family Status:
  %span.md-caption {{ format(encounter.background_history.marital_status)}}; {{format(encounter.background_history.family_status)}}
%div(flex="50")
  %strong.md-caption Educational background:
  %span.md-caption {{format(encounter.background_history.education_status)}}

%div(flex="50")
  %strong.md-caption Social/Occupational background:
  %span.md-caption {{ format(encounter.background_history.occupational_status)}}
%div(flex="50")
  %strong.md-caption Place of birth:
  %span.md-caption {{format(encounter.background_history.birth_place)}}

%div(flex="50")
  %strong.md-caption Family Background:
  %span.md-caption {{format(encounter.background_history.family_background) }}
%div(flex="50")
  %strong.md-caption Raised by:
  %span.md-caption {{format(encounter.background_history.raised_by)}}

%div(flex="100")
  %strong.md-caption History of mental illness:
  %span.md-caption {{format(encounter.background_history.hist_mental_ill)}}

%div(flex="100")
  %strong.md-caption Religious/Spiritual status:
  %span.md-caption {{format(encounter.background_history.religious_status)}}

%div(flex="50")
  %strong.md-caption Psychiatric medication:
  %span.md-caption {{format(encounter.background_history.onpsychmeds)}}
  %span.md-caption(ng-if="encounter.background_history.onpsychmeds.name == 'Y'") ; {{format(encounter.background_history.onpsychmeds_medication) }}
%div(flex="50" ng-if="encounter.background_history.onpsychmeds.name == 'Y' && encounter.background_history.gdr_plan.name")
  %strong.md-caption GDR plan in place:
  %span.md-caption {{format(encounter.background_history.gdr_plan)}}
  %span.md-caption(ng-if="encounter.background_history.gdr_plan.name == 'Y'") - {{encounter.background_history.gdr_plan_date | dateonly}}

%div(flex="100")
  %strong.md-caption Relevant Medical Condition(s):
  %span.md-caption {{format(encounter.background_history.medical_conditions)}}

%div(flex="100" ng-if="encounter.background_history.note")
  %strong.md-caption Comments:
  %span.md-caption {{format(encounter.background_history.note)}}

%h4(flex="100") IV. Problem Description

%div(ng-if="is90791" layout="row" layout-wrap)
  %div(flex="50")
    %strong.md-caption Problem onset:
    %span.md-caption {{format(encounter.problem.onset) }}
  %div(flex="50")
    %strong.md-caption Problem frequency/intensity:
    %span.md-caption {{format(encounter.problem.frequency) }}; {{format(encounter.problem.intensity)  }}

  %div(flex="100")
    %strong.md-caption Other reported problems:
    %span.md-caption {{format(encounter.problem.other) }}

  %div(flex="100")
    %strong.md-caption Staff impression:
    %span.md-caption {{format(encounter.problem.staffimpression) }}

  %div(flex="100")
    %strong.md-caption Precipitating stressors:
    %span.md-caption {{format(encounter.problem.precipstressors) }}

  %div(flex="100")
    %strong.md-caption Observations and background summary:
    %span.md-caption {{format(encounter.problem.observation) }}

%div(ng-if="!is90791" layout="row" layout-wrap)
  %div(flex="100")
    %strong.md-caption Problem intensity:
    %span.md-caption {{format(encounter.problem.intensity) }}
  %div(flex="100")
    %strong.md-caption Crisis state due to:
    %span.md-caption {{format(encounter.problem.crisis_state) }}
  %div(flex="100")
    %strong.md-caption This issue presented itself:
    %span.md-caption {{format(encounter.problem.crisis_history) }}
  %div(flex="100")
    %strong.md-caption Personal reaction of the patient:
    %span.md-caption {{format(encounter.problem.crisis_distress) }}
  %div(flex="100" ng-if="encounter.problem.crisis_comment")
    %strong.md-caption Comments:
    %span.md-caption {{ encounter.problem.crisis_comment }}

%h4(flex="100") V. Diagnosis and Prognosis

%div(flex="33")
  %strong.md-caption Primary Diagnosis:
  %span.md-caption {{format(encounter.diagnosis.primary) }}
%div(flex="33")
  %div(ng-if="encounter.diagnosis.secondary")
    %strong.md-caption Secondary Diagnosis:
    %span.md-caption {{format(encounter.diagnosis.secondary) }}
%div(flex="33")
  %strong.md-caption Prognosis:
  %span.md-caption {{format(encounter.diagnosis.prognosis) }}

%div(flex="100" ng-if="encounter.diagnosis.comment")
  %strong.md-caption General goals (subject to treatment plan):
  %span.md-caption {{format(encounter.diagnosis.comment) }}

%div(ng-if="is90791" layout="row" layout-wrap)
  %span(ng-if="hasPlan")
    %h4(flex="100") VI. Initial recommendations and plan

    %div(flex="100")
      %strong.md-caption Type/amount of psychotherapy service recommended:
      %span.md-caption {{format(encounter.plan.amount_of_service) }}
    %div(flex="100" ng-if="encounter.plan.amount_of_service.name == '4'")
      %strong.md-caption Reason psychotherapy not recommended:
      %span.md-caption {{format(encounter.plan.not_recommended_reason) }}

    %div(flex="50" ng-if="encounter.plan.amount_of_service.name != '4'")
      %strong.md-caption Frequency:
      %span.md-caption {{format(encounter.plan.frequency) }}
    %div(flex="50" ng-if="encounter.plan.amount_of_service.name != '4'")
      %strong.md-caption Duration:
      %span.md-caption {{format(encounter.plan.duration) }}

    %div(flex="100" ng-if="encounter.plan.amount_of_service.name != '4' && encounter.plan.other_services")
      %strong.md-caption Other services recommended:
      %span.md-caption {{format(encounter.plan.other_services) }}

  %span(ng-if="hasCompetency")
    %h4(flex="100") VIb. Competency Findings

    %div(flex="100")
      %strong.md-caption Competency Findings
      %span.md-caption {{format(encounter.competency.findings)}}

    %div(flex="100" ng-if="encounter.competency.comment")
      %strong.md-caption Comments
      %span.md-caption {{format(encounter.competency.comment)}}

%div(ng-if="!is90791" layout="row" layout-wrap)
  %h4(flex="100") VI. Interventions

  %div(flex="66")
    %strong.md-caption Psychotherapy:
    %span.md-caption {{format(encounter.plan.crisis_psychotherapy)}}
  %div(flex="33" ng-if="encounter.plan.crisis_psychotherapy_comment")
    %strong.md-caption Comments:
    %span.md-caption {{encounter.plan.crisis_psychotherapy_comment}}

  %div(flex="66")
    %strong.md-caption Mobilization of resources to defuse crisis and restore safety:
    %span.md-caption {{format(encounter.plan.crisis_mobilization)}}
  %div(flex="33" ng-if="encounter.plan.crisis_mobilization_comment")
    %strong.md-caption Comments
    %span.md-caption {{encounter.plan.crisis_mobilization_comment}}

  %div(flex="100")
    %strong.md-caption Intervention summary:
    %span.md-caption {{encounter.plan.crisis_intervention_summary}}

  %div(flex="66")
    %strong.md-caption Assessment of suicide/homicide risk:
    %span.md-caption {{format(encounter.plan.crisis_risk_assessment)}}
  %div(flex="33" ng-if="encounter.plan.crisis_risk_assessment_comment")
    %strong.md-caption Comments:
    %span.md-caption {{encounter.plan.crisis_risk_assessment_comment}}

  %div(flex="100")
    %strong.md-caption Recommendations:
    %span.md-caption {{format(encounter.plan.crisis_recommendations)}}
    %span.md-caption(ng-if="encounter.plan.crisis_recommendations.name == '1'") {{ encounter.plan.crisis_recommendation_until }}

  %div(flex="100" ng-if="encounter.plan.crisis_additional_time.name=='Y'")
    %strong.md-caption Additional time required:
    %span.md-caption {{ format(encounter.plan.crisis_additional_time_minutes) }}

%div.certification(flex="100" ng-if="encresource.cpt_encounter_code == '90791' && encounter.plan && encounter.plan.amount_of_service.name != '4'")
  {{ certTexts.followup }}

%div.certification(flex="100" ng-if="encresource.cpt_encounter_code == '90839' || (encounter.plan && encounter.plan.amount_of_service.name == '4') || hasCompetency")
  {{ certTexts.initial }}


