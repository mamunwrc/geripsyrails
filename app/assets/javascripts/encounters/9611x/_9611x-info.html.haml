%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %span(flex)
    %span( flex="30" class="label") Last Name:
    %span( flex="70" class="md-caption") {{myPatient.last_name}}
  %span(flex)
    %span( flex="30" class="label") First Name:
    %span( flex="70" class="md-caption") {{myPatient.first_name}}
  %span(flex)
    %span( flex="30" class="label") DOB:
    %span( flex="70" class="md-caption") {{myPatient.dob | dateonly}}
  %span(flex)
    %span( flex="30" class="label") Dates of Service:
    %span( flex="70" class="md-caption") {{ myEncounter.testing_service_dates.join('; ') }}

%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %span(flex)
    %span( flex="30" class="label") Facility:
    %span( flex="70" class="md-caption") {{myPatient.facility.name}}
  %span(flex)
    %span( flex="30" class="label") Gender:
    %span( flex="70" class="md-caption") {{myPatient.gender.val || myPatient.gender}}
  %span(flex)

%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %gd-date(ng-blur="formsec.sections.info.revalidate" ng-required="true" field-name="service_date" form="formsec.sections.info.form" is-edit="isEditing" label="Billing Date" ng-model="myEncounter.referral.service_date" flex)

%md-divider

%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %gd-text(form="formsec.sections.info.form" is-edit="isEditing" label="History, Background & Behavioral Observations" ng-model="myEncounter.referral.observations" ng-required="true" flex )

%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %gd-dd-multiselect(ng-blur="formsec.sections.info.revalidate" ng-required="true" form="formsec.sections.info.form" freetext="true" is-edit="isEditing" dd-type="encounter" keyprefix="REFREASONS9611X" label="Reasons for Referral" ng-model="myEncounter.referral.reasons" flex)

%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %gd-dd-multiselect(ng-blur="formsec.sections.info.revalidate" ng-required="true" form="formsec.sections.info.form" freetext="true" is-edit="isEditing" dd-type="encounter" keyprefix="SRV9611X" label="Services Conducted" ng-model="myEncounter.referral.services_conducted" flex)
  %div(flex ng-show="__hasWais || __hasGraph")
    %div(layout-column)
      %gd-text(form="formsec.sections.info.form" is-edit="isEditing" label="WAIS subtest(s) and version administered" ng-model="myEncounter.referral.wais_extra" ng-required="__hasWais" ng-show="__hasWais" flex )
      %gd-text(form="formsec.sections.info.form" is-edit="isEditing" label="Graphomotor" ng-model="myEncounter.referral.graphomotor_extra" ng-required="__hasGraph" ng-show="__hasGraph" flex )

%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %md-input-container.md-block.md-input-invalid(flex-gt-sm ng-show="isEditing")
    %label Code for testing evaluation services
    %md-select(ng-model="myEncounter.referral.code" name="procedure_code" ng-required="true")
      %md-option(ng-repeat="code in testing.codes" ng-value="{{code}}") {{ code }} - {{ testing.headers[code] }}

  %div(ng-if="::!isEditing")
    %span.label(flex="20") {{::label}}:
    %span.md-caption(flex="30") {{ myEncounter.referral.code }}

  %gd-input(form="formsec.sections.info.form" is-edit="isEditing" label="Total evaluation services time (in minutes)" ng-model="myEncounter.referral.minutes" ng-required="true" type="number" flex )
  %gd-input(form="formsec.sections.info.form" is-edit="isEditing" label="Dates of service for testing evaluation services" ng-model="myEncounter.referral.eval_dates" ng-required="true" flex )


%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %gd-input(ng-blur="formsec.sections.info.revalidate" form="formsec.sections.info.form" is-edit="isEditing" label="Total test administration and scoring time by psychologist (in minutes)" ng-model="myEncounter.referral.scoring_minutes" ng-required="false" type="number" flex )
  %gd-input(ng-blur="formsec.sections.info.revalidate" form="formsec.sections.info.form" is-edit="isEditing" label="Dates of service for test administration and scoring (by psychologist)" ng-model="myEncounter.referral.scoring_dates" ng-show="myEncounter.referral.scoring_minutes > 1" ng-required="myEncounter.referral.scoring_minutes > 1" flex )

%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %gd-input(ng-blur="formsec.sections.info.revalidate" form="formsec.sections.info.form" is-edit="isEditing" label="Total test administration and scoring by technician time (in minutes)" ng-model="myEncounter.referral.tech_scoring_minutes" ng-required="false" type="number" flex )
  %gd-input(ng-blur="formsec.sections.info.revalidate" form="formsec.sections.info.form" is-edit="isEditing" label="Dates of service for test administration and scoring (by technician)" ng-model="myEncounter.referral.tech_scoring_dates" ng-required="false" ng-show="myEncounter.referral.tech_scoring_minutes > 1" ng-required="myEncounter.referral.tech_scoring_minutes > 1" flex )
  %gd-input(ng-blur="formsec.sections.info.revalidate" form="formsec.sections.info.form" is-edit="isEditing" label="Name and title of technician" ng-model="myEncounter.referral.tech_scoring_name" ng-show="myEncounter.referral.tech_scoring_minutes > 1" ng-required="myEncounter.referral.tech_scoring_minutes > 1" flex )

%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %gd-input(ng-blur="formsec.sections.info.revalidate" form="formsec.sections.info.form" is-edit="isEditing" label="Number of computerized tests used (if any)" ng-model="myEncounter.referral.computer_test_count" ng-required="false" type="number" flex )
  %gd-input(ng-blur="formsec.sections.info.revalidate" form="formsec.sections.info.form" is-edit="isEditing" label="Dates computerized tests were administered" ng-model="myEncounter.referral.computer_dates" ng-required="myEncounter.referral.computer_test_count > 0" ng-show="myEncounter.referral.computer_test_count > 0" flex )
  %gd-input(ng-blur="formsec.sections.info.revalidate" form="formsec.sections.info.form" is-edit="isEditing" label="Names of computerized tests administered" ng-model="myEncounter.referral.computer_names" ng-required="myEncounter.referral.computer_test_count > 0" ng-show="myEncounter.referral.computer_test_count > 0" flex )

%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %gd-text(ng-blur="formsec.sections.info.revalidate" form="formsec.sections.info.form" is-edit="isEditing" label="Present evaluation" ng-model="myEncounter.referral.evaluation" ng-required="true" flex )

-# icd list
%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %gd-drop-down(ng-blur="formsec.sections.info.revalidate" form="formsec.sections.info.form" ng-blur="formsec.sections.info.revalidate" ng-required="true" is-edit="isEditing" filterable dd-type="icds" label="Primary Diagnosis" ng-model="myEncounter.diagnosis.primary" flex)
  %gd-drop-down(ng-blur="formsec.sections.info.revalidate" form="formsec.sections.info.form" is-edit="isEditing" filterable dd-type="icds" label="Secondary Diagnosis" ng-model="myEncounter.diagnosis.secondary" flex)

%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %gd-text(ng-blur="formsec.sections.info.revalidate" form="formsec.sections.info.form" is-edit="isEditing" label="Recommendations for interventions" ng-model="myEncounter.referral.recommendations" ng-required="true" flex )


-#
  %div(layout-gt-xs="row" layout-xs="column" layout-padding)
    %gd-dd-multiselect(ng-blur="formsec.sections.info.revalidate" ng-required="true" form="formsec.sections.info.form" freetext="true" is-edit="isEditing" dd-type="encounter" keyprefix="REFINITIATOR" label="Referral initiated by" ng-model="myEncounter.referral.initiator" flex)
    %gd-drop-down(ng-blur="formsec.sections.info.revalidate" ng-required="true" form="formsec.sections.info.form" is-edit="isEditing" label="Referring MD name" ng-model="myEncounter.referral.md_name" collection="mdNames" flex)

  %div(layout-gt-xs="row" layout-xs="column" layout-padding)
    %gd-date(ng-blur="formsec.sections.info.revalidate" ng-required="true" field-name="service_date" form="formsec.sections.info.form" is-edit="isEditing" label="Date of Service" ng-model="myEncounter.referral.service_date" flex)
    %gd-date(ng-blur="formsec.sections.info.revalidate" ng-required="true" field-name="md_order_date" form="formsec.sections.info.form" is-edit="isEditing" label="Date of MD order" ng-model="myEncounter.referral.order_date" flex)

  %div(layout-gt-xs="row" layout-xs="column" layout-padding)
    %gd-bool(form="formsec.sections.info.form" is-edit="isEditing" label="Was patient previously seen for evaluation (90791) in the last year?" ng-model="myEncounter.referral.hiatus" ng-required="true" ng-blur="formsec.sections.info.revalidate" flex)
    %div(ng-show="myEncounter.referral.hiatus.name == 'Y'" flex)
      %gd-drop-down(form="formsec.sections.info.form" is-edit="isEditing" label="Reason for treatment hiatus" ng-model="myEncounter.referral.hiatus_reason" dd-type="encounter" keyprefix="HAS90791THISYEAR" freetext="true" ng-required="myEncounter.referral.hiatus.name == 'Y'" ng-blur="formsec.sections.info.revalidate" flex)
      %gd-date(ng-model="myEncounter.referral.hiatus_date" is-edit="isEditing" is-open="openHiatusDate" ng-if="showHiatusDate" flex ng-required="showHiatusDate")
      %gd-input(is-edit="isEditing" ng-model="myEncounter.referral.hiatus_comment" placeholder="Comment" flex)

  %div(layout-gt-xs="row" layout-xs="column" layout-padding)
    %gd-dd-multiselect(ng-blur="formsec.sections.info.revalidate" ng-required="true" form="formsec.sections.info.form" is-edit="isEditing" dd-type="encounter" keyprefix="REFREASONS" label="Reason for referral" ng-model="myEncounter.referral.reasons" opt-freetext="true" opt-freetext="true" flex)
  %div(layout-gt-xs="row" layout-xs="column" layout-padding)
    %gd-input(form="formsec.sections.info.form" is-edit="isEditing" label="State behavioral issues present" ng-model="myEncounter.referral.reasons_freetext[1]" ng-show="evaluationSelected()" flex )
    %gd-input(form="formsec.sections.info.form" is-edit="isEditing" label="State diagnostic question" ng-model="myEncounter.referral.reasons_freetext[2]" ng-show="competencySelected()" flex )

  %div(layout-gt-xs="row" layout-xs="column" layout-padding)
    %span(flex)
      %gd-dd-multiselect(ng-blur="formsec.sections.info.revalidate" ng-required="true" form="formsec.sections.info.form" freetext="true" is-edit="isEditing" dd-type="encounter" keyprefix="MEDICALNECESSITY" label="Medical Necessity" ng-model="myEncounter.referral.medical_necessity" flex)

  %div(ng-if="isEditing")
    %md-divider

    %facility-pos(ng-model="myEncounter.facility_pos_code")

    %md-divider

    %div(layout-gt-xs="row" layout-xs="column" layout-padding)
      %div(flex)
        %md-checkbox(ng-model="myEncounter.unbilled" aria-label="is encounter unbilled?")
          Is this an Unbilled 90791?

