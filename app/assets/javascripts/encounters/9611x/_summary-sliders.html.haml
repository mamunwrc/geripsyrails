%div(layout="row")
  %span(flex="20")
  %div(flex layout layout-align="center center")
    %h3.italic {{ ::label }}
  %span(flex="10")

%div(layout="row" layout-padding layout-align="start center")
  %span(flex)
  %div(flex)
    %h4 None
  %div(flex)
    %h4 Mild
  %div(flex)
    %h4 Moderate
  %div(flex)
    %h4 Severe

%div(layout="row" layout-padding ng-repeat="opt in opts")
  %span.italic(flex="20") {{ opt.text }}

  %md-slider-container(flex ng-disabled="::!isEdit")
    %md-slider(flex md-discrete ng-model="model[modelContainer][opt.name]" step="1" min="0" max="10" aria-label="{{ ::label }}")
  %span(flex="10")

