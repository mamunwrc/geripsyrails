.odd(layout-gt-xs="row" layout-padding)
  %gd-drop-down(form="formsec.sections.history.form" ng-blur="formsec.sections.history.revalidate" ng-required="true" freetext="true" ft-model="myEncounter.background_history.marital_status_text" is-edit="isEditing" dd-type="main" keyprefix="MARITALSTATUS" label="Marital Status" ng-model="myEncounter.background_history.marital_status" flex)
  %gd-drop-down(form="formsec.sections.history.form" ng-blur="formsec.sections.history.revalidate" ng-required="true" freetext="true" ft-model="myEncounter.background_history.family_status_text" is-edit="isEditing" dd-type="main" keyprefix="FAMILYSTATUS" label="Family Status" ng-model="myEncounter.background_history.family_status" flex)
.even(layout-gt-xs="row" layout-padding)
  %gd-drop-down(form="formsec.sections.history.form" ng-blur="formsec.sections.history.revalidate" ng-required="true" freetext="true" ft-model="myEncounter.background_history.education_status_text" is-edit="isEditing" dd-type="main" keyprefix="EDUSTATUS" label="Educational background" ng-model="myEncounter.background_history.education_status" flex)
  %gd-drop-down(form="formsec.sections.history.form" ng-blur="formsec.sections.history.revalidate" ng-required="true" freetext="true" ft-model="myEncounter.background_history.occupational_status_text" is-edit="isEditing" dd-type="main" keyprefix="OCCUPATION" label="Social/Occupational background" ng-model="myEncounter.background_history.occupational_status" flex)
.odd(layout-gt-xs="row" layout-padding)
  %gd-drop-down(form="formsec.sections.history.form" ng-blur="formsec.sections.history.revalidate" ng-required="true" freetext="true" ft-model="myEncounter.background_history.birth_place_text" is-edit="isEditing" dd-type="main" keyprefix="BIRTHPLACE" label="Place of Birth" ng-model="myEncounter.background_history.birth_place" flex)
  %gd-drop-down(form="formsec.sections.history.form" ng-blur="formsec.sections.history.revalidate" ng-required="true" freetext="true" ft-model="myEncounter.background_history.family_background_text" is-edit="isEditing" dd-type="main" keyprefix="FAMILYBACKGRND" label="Family background" ng-model="myEncounter.background_history.family_background" flex)
  %gd-drop-down(form="formsec.sections.history.form" ng-blur="formsec.sections.history.revalidate" ng-required="true" freetext="true" ft-model="myEncounter.background_history.raised_by_text" is-edit="isEditing" dd-type="main" keyprefix="RAISEDBY" label="Raised by" ng-model="myEncounter.background_history.raised_by" flex)
.even(layout-gt-xs="row" layout-padding)
  %div(flex)
    %gd-dd-multiselect(form="formsec.sections.history.form" ng-blur="formsec.sections.history.revalidate" ng-required="true" freetext="true" ft-model="myEncounter.background_history.hist_mental_ill_text" is-edit="isEditing" dd-type="main" keyprefix="HISTMETNALILL" label="History of Mental Illness" ng-model="myEncounter.background_history.hist_mental_ill" flex)
    %gd-input(form="formsec.sections.history.form" is-edit="isEditing" label="Comments" ng-model="myEncounter.background_history.history_comment" flex)
  %div(flex)
    %gd-drop-down(form="formsec.sections.history.form" ng-blur="formsec.sections.history.revalidate" ng-required="true" freetext="true" ft-model="myEncounter.background_history.religious_status_text" is-edit="isEditing" dd-type="main" keyprefix="RELIGIOUSSTATUS" label="Religious/Spiritual Status" ng-model="myEncounter.background_history.religious_status" flex)
.odd(layout-gt-xs="row" layout-padding)
  %gd-radio(form="formsec.sections.history.form" ng-blur="formsec.sections.history.revalidate" ng-required="true" is-edit="isEditing" label="Psychiatric Medications" dd-type="main" keyprefix="ONMEDS" ng-model="myEncounter.background_history.onpsychmeds" flex)
  %div(flex)
    %gd-input(form="formsec.sections.history.form" is-edit="isEditing" label="Psychiatric Medication" ng-model="myEncounter.background_history.onpsychmeds_medication" ng-show="myEncounter.background_history.onpsychmeds.name =='Y'" flex)
    %gd-drop-down(form="formsec.sections.history.form" ng-blur="formsec.sections.history.revalidate" ng-required="myEncounter.background_history.onpsychmeds.name =='Y'" ng-show="myEncounter.background_history.onpsychmeds.name =='Y'" is-edit="isEditing" dd-type="encounter" keyprefix="GDRPLAN" label="GDR (gradual dosage reduction) plan" ng-model="myEncounter.background_history.gdr_plan" flex)
    %gd-date(form="formsec.sections.history.form" is-edit="isEditing" is-open="openGDRDate" label="GDR date of plan" ng-required="myEncounter.background_history.onpsychmeds.name == 'Y' && myEncounter.background_history.gdr_plan.name == 'Y'" ng-model="myEncounter.background_history.gdr_plan_date" ng-if="myEncounter.background_history.onpsychmeds.name == 'Y' && myEncounter.background_history.gdr_plan.name == 'Y'" flex)
.even(layout-gt-xs="row" layout-padding)
  %gd-input(form="formsec.sections.history.form" ng-blur="formsec.sections.history.revalidate" ng-required="true" is-edit="isEditing" label="Relevant Medical Condition(s)" ng-model="myEncounter.background_history.medical_conditions" flex)
.odd(layout-gt-xs="row" layout-padding)
  %gd-input(form="formsec.sections.history.form" is-edit="isEditing" label="Comments" ng-model="myEncounter.background_history.note" flex)
