%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %span(flex)
    %span( flex="30" class="label") Last Name:
    %span( flex="70" class="md-caption") {{myPatient.last_name}}
  %span(flex)
    %span( flex="30" class="label") First Name:
    %span( flex="70" class="md-caption") {{myPatient.first_name}}
  %span(flex)
    %span( flex="30" class="label") DOB:
    %span( flex="70" class="md-caption") {{myPatient.dob | dateonly}}

%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %span(flex)
    %span( flex="30" class="label") Facility:
    %span( flex="70" class="md-caption") {{myPatient.facility.name}}
  %span(flex)
    %span( flex="30" class="label") Gender:
    %span( flex="70" class="md-caption") {{myPatient.gender.val || myPatient.gender}}
  %span(flex)

%md-divider

%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %gd-dd-multiselect(ng-blur="formsec.sections.info.revalidate" ng-required="true" form="formsec.sections.info.form" freetext="true" is-edit="isEditing" dd-type="encounter" keyprefix="REFINITIATOR" label="Referral initiated by" ng-model="myEncounter.referral.initiator" flex)
  %gd-drop-down(ng-blur="formsec.sections.info.revalidate" ng-required="true" form="formsec.sections.info.form" is-edit="isEditing" label="Referring MD name" ng-model="myEncounter.referral.md_name" collection="mdNames" flex)

%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %gd-date(ng-blur="formsec.sections.info.revalidate" ng-required="true" field-name="service_date" form="formsec.sections.info.form" is-edit="isEditing" label="Date of Service" ng-model="myEncounter.referral.service_date" flex)
  %gd-date(ng-blur="formsec.sections.info.revalidate" ng-required="true" field-name="md_order_date" form="formsec.sections.info.form" is-edit="isEditing" label="Date of MD order" ng-model="myEncounter.referral.order_date" flex)

%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %gd-bool(form="formsec.sections.info.form" is-edit="isEditing" label="Was patient previously seen for evaluation (90791) in the last year?" ng-model="myEncounter.referral.hiatus" ng-required="true" ng-blur="formsec.sections.info.revalidate" flex)
  %div(ng-show="myEncounter.referral.hiatus.name == 'Y'" flex)
    %gd-drop-down(form="formsec.sections.info.form" is-edit="isEditing" label="Reason for treatment hiatus" ng-model="myEncounter.referral.hiatus_reason" dd-type="encounter" keyprefix="HAS90791THISYEAR" freetext="true" ng-required="myEncounter.referral.hiatus.name == 'Y'" ng-blur="formsec.sections.info.revalidate" flex)
    %gd-date(ng-model="myEncounter.referral.hiatus_date" is-edit="isEditing" is-open="openHiatusDate" ng-if="showHiatusDate" flex ng-required="showHiatusDate")
    %gd-input(is-edit="isEditing" ng-model="myEncounter.referral.hiatus_comment" placeholder="Comment" flex)

%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %gd-dd-multiselect(ng-blur="formsec.sections.info.revalidate" ng-required="true" form="formsec.sections.info.form" is-edit="isEditing" dd-type="encounter" keyprefix="REFREASONS" label="Reason for referral" ng-model="myEncounter.referral.reasons" opt-freetext="true" opt-freetext="true" flex)
%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %gd-input(form="formsec.sections.info.form" is-edit="isEditing" label="State behavioral issues present" ng-model="myEncounter.referral.reasons_freetext[1]" ng-show="evaluationSelected()" flex )
  %gd-input(form="formsec.sections.info.form" is-edit="isEditing" label="State diagnostic question" ng-model="myEncounter.referral.reasons_freetext[2]" ng-show="competencySelected()" flex )

%div(layout-gt-xs="row" layout-xs="column" layout-padding)
  %span(flex)
    %gd-dd-multiselect(ng-blur="formsec.sections.info.revalidate" ng-required="true" form="formsec.sections.info.form" freetext="true" is-edit="isEditing" dd-type="encounter" keyprefix="MEDICALNECESSITY" label="Medical Necessity" ng-model="myEncounter.referral.medical_necessity" flex)

%div(ng-if="isEditing")
  %md-divider

  %facility-pos(ng-model="myEncounter.facility_pos_code")

  %md-divider

  %div(layout-gt-xs="row" layout-xs="column" layout-padding)
    %div(flex)
      %md-checkbox(ng-model="myEncounter.unbilled" aria-label="is encounter unbilled?")
        Is this an Unbilled 90791?

