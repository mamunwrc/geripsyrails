%md-input-container.md-block(flex ng-show="::isEdit")
  %label {{::label}}
  %input( placeholder="{{placeholder}}" ng-model="myData" ng-blur="::onBlur($event)" minlength="{{::minlength}}" type="{{::type}}" ng-required="::isRequired" name="{{::fieldName}}" ng-readonly="::!isEdit")
  %div(ng-messages="form[fieldName].$error" role="alert" md-auto-hide="false")
    %div(ng-message="required") This is required.
    %div(ng-message="email") This field must be a valid email address.
    %div(ng-message="minlength") This field is too short.

%div(flex ng-if="::!isEdit")
  %span.label(flex-gt-xs="40") {{ ::label }}:
  %span.md-caption(flex-gt-xs="60") {{::myData}}

