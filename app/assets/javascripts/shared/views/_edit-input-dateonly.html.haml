%md-input-container.md-block(flex ng-show="::isEdit")
  %label {{ ::label }}
  %md-datepicker(ng-model="myData" ng-change="::fixdate(myData)" md-placeholder="{{::label}}" name="{{::fieldName}}" ng-required="::isRequired" ng-blur="::onBlur($event)" md-is-open="::isOpen" flex)

  .validation-messages(ng-messages="form[fieldName].$error")
    %div(ng-message="valid") The entered value is not a date
    %div(ng-message="required") This date is required


%div(ng-if="::!isEdit")
  %span.label(flex="20") {{ ::label }}:
  %span.md-caption(flex="30") {{ ::myData |dateonly }}
