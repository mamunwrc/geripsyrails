%md-input-container.md-block(flex ng-show="::isEdit")
  %span.label {{::label}}
  %md-radio-group( name="{{::fieldName}}" id="{{::fieldName}}" ng-model="myData.name" ng-required="{{::isRequired}}" ng-disabled="::!isEdit" layout="row" )
    %md-radio-button( value="Y" ng-click="myData.val = 'Yes'" ng-blur="::onBlur($event)") Yes
    %md-radio-button( value="N" ng-click="myData.val = 'No'" ng-blur="::onBlur($event)") No
  %div(ng-messages="form[fieldName].$error" role="alert" md-auto-hide="false")
    %div(ng-message="required") This field is required.


%gd-input(is-edit="true" field-name="{{fieldName + '_freetext'}}" ng-if="isEdit && freetext && myData.name == 'Y'" ng-model="myData.freetext" label="")

%div(flex ng-hide="::isEdit")
  %span.label(flex-gt-xs="40") {{ ::label }}:
  %span.md-caption(flex-gt-xs="60") {{::myData.val}}
