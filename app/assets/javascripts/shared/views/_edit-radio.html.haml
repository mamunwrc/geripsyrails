%md-input-container.md-block(flex ng-show="::isEdit")
  %span.label {{::label}}
  %md-radio-group( name="{{::fieldName}}" id="{{::fieldName}}" ng-model="myData.name" ng-required="{{::isRequired}}" layout="row" layout-align="start center")
    %md-radio-button( ng-repeat="option in collectionData" ng-value="option.keyname" ng-click="myData.val=option.keyvalue" ng-blur="::onBlur($event)" flex) {{::option.keyvalue}}

%div(ng-if="::!isEdit" flex)
  %span.label(flex="40") {{::label}}:
  %span.md-caption(flex="60") {{ ::myData.val }}
