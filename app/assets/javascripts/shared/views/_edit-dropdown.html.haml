%md-input-container.md-block.md-input-invalid(flex-gt-sm ng-show="::isEdit")
  %label {{ ::label }}
  %md-select(ng-model="myData" md-on-close="clearSearchTerm()" name="{{::fieldName}}" ng-required="::isRequired" ng-blur="::onBlur($event)" ng-change="onChange($event, $value)" ng-model-options="{trackBy: '$value.name'}")
    %md-select-header.dd-search-header(ng-show="::filterable")
      %input.md-text.dd-search-filter(ng-model="searchTerm" type="search" placeholder="Filter list...")
    %md-option(ng-value="{{undefined}}")
    %md-option(ng-repeat="item in collectionData |filter:searchTerm" ng-value="valForField(item)")
      {{::item.keyvalue}}
  %div(ng-messages="form[fieldName].$error" role="alert" md-auto-hide="false")
    %div(ng-message="required") This is required.
    %div(ng-message="email") This field must be a valid email address.
    %div(ng-message="minlength") This field is too short.

%gd-input(form="form" is-edit="true" field-name="{{fieldName + '_freetext'}}" ng-show="isEdit && myData.name == 'FREETEXT'" ng-model="myData.freetext" label="{{ftLabel}}" ng-required="ftRequired && isEdit && myData.name == 'FREETEXT'")

%div(ng-if="::!isEdit")
  %span.label(flex="20") {{::label}}:
  %span.md-caption(flex="30") {{ ::myData.name === 'FREETEXT' ? myData.freetext : myData.val }}

